# Copy to .env for the demo stack:  cp .env.example .env
# These are DEMO defaults — change the secrets before exposing anything.

# --- DefectDojo admin (used to log in at :8080 and by dojo-dash to read the API) ---
DD_ADMIN_USER=admin
DD_ADMIN_PASSWORD=admin
DD_DATABASE_PASSWORD=defectdojo

# DefectDojo needs two long random secrets. Generate real ones, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DD_SECRET_KEY=please-change-me-in-dot-env
DD_CREDENTIAL_AES_256_KEY=please-change-me-32-bytes-minimum

# Pin a DefectDojo release (recommended) instead of :latest, e.g. DD_VERSION=2.39.0
DD_VERSION=latest

# --- dojo-dash ---
# Poll cadence / page auto-reload, seconds (production default is 300 = 5 min).
REPORT_REFRESH_INTERVAL=60
# Run a locally-built image instead of the published one:  DOJO_DASH_IMAGE=dojo-dash:dev
# DOJO_DASH_IMAGE=ghcr.io/nuday-ai/dojo-dash:latest

# --- Optional: Critical/High new-finding email alerts (see docs/alerting.md) ---
# Leave ALERT_EMAILS empty to disable. When set (with an SMTP URL), the poller emails
# once per newly-appeared Critical/High finding.
# ALERT_EMAILS=secops@example.com
# ALERT_SMTP_URL=smtp+tls://USER:PASS@smtp.example.com:587
# ALERT_FROM=dojo-dash@example.com
# ALERT_LINK_BASE=http://localhost:8080
